id: tigit04-unio-controls
title: Tres municipis per comprovar la unió
source_prompt: >-
  Recorregut QGIS de TIGIT, practiques/tigit-04-qgis-mapes/captures/recorregut-complet.prompt.md.
  Mostrar el resultat persistent de la unió i tres casos de control llegibles:
  Vila-seca, Roda de Berà i la Pobla de Mafumet. La vista de tres municipis
  és una selecció docent del resultat de 22, no una nova taula d'origen.
runtime:
  image: sha256:1003721d96abe9607d8337b36851f9b29f84c2f8f92b377d1a73ff03c9d15cd2
  locale: ca_ES
  display_backend: offscreen
plugins: [processing]
project:
  source: sandbox/practiques/tigit-projecte-territorial/0.1.0/ca/run05-contract-20261014/payload/projects/tigit-04-dades-espacials.qgz
  output: sandbox/practiques/tigit-04-qgis-mapes/0.3.0/projects/unio-controls-01.qgz
  title: TIGIT · tres casos de control de la unió
  native_profile: qgis-practice-v2
  reuse: if_fresh
  font_files:
    DejaVu Sans: sandbox/practiques/tigit-projecte-territorial/0.1.0/ca/run05-contract-20261014/payload/data/fonts/DejaVuSans.ttf
  composition:
    script: practiques/tigit-projecte-territorial/activities/qgis-territorial.py
    project_id: control-table
    parameters:
      views:
        control-table: join
      control_municipalities: ["431711", "431310", "431093"]
    products: {}
setup:
  - action: load_vector
    path: sandbox/practiques/tigit-projecte-territorial/0.1.0/ca/run05-contract-20261014/payload/data/processed/municipal_joined.gpkg|layername=municipal_joined
    name: Municipis · unió
  - action: clear_message_bar
presentation:
  active_layer: Municipis · unió
  checks:
    project_crs: EPSG:25831
    required_layers: [Municipis · base, Municipis · unió, Indicadors · Idescat 2021]
    persistent_layers: [Municipis · unió]
captures:
  - id: taula-control
    mode: window
    target:
      class_name: QgsAttributeTableDialog
    steps:
      - action: open_attribute_table
        layer: Municipis · unió
        wait_ms: 800
    drawings: []
